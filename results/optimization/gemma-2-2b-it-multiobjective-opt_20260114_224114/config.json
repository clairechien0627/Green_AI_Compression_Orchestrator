{
  "experiment": {
    "name": "gemma-2-2b-it-multiobjective-opt",
    "output_dir": "results/optimization"
  },
  "baseline": {
    "model_name": "google/gemma-2-2b-it",
    "model_dtype": "float16",
    "device_map": "cuda:0",
    "trust_remote_code": true,
    "datasets": {
      "gsm8k": {
        "enabled": true,
        "num_samples": 50
      },
      "truthfulqa": {
        "enabled": true,
        "num_samples": 50
      },
      "commonsenseqa": {
        "enabled": false,
        "num_samples": 50
      },
      "humaneval": {
        "enabled": false,
        "num_samples": 50
      },
      "bbh": {
        "enabled": false,
        "num_samples": 50
      }
    }
  },
  "quantization_eval": {
    "use_same_datasets_as_baseline": true,
    "custom_datasets": {
      "gsm8k": {
        "num_samples": 50
      },
      "truthfulqa": {
        "num_samples": 50
      },
      "humaneval": {
        "num_samples": 25
      }
    }
  },
  "multiobjective": {
    "objectives": [
      {
        "name": "accuracy_change",
        "direction": "maximize",
        "weight": 2.0
      },
      {
        "name": "gpu_peak_change",
        "direction": "minimize",
        "weight": 1.0
      },
      {
        "name": "latency_change",
        "direction": "minimize",
        "weight": 1.0
      }
    ],
    "aggregation": {
      "method": "average",
      "dataset_weights": {
        "gsm8k": 0.4,
        "truthfulqa": 0.3,
        "humaneval": 0.3
      }
    },
    "constraints": {
      "enabled": true,
      "accuracy_min": -0.5,
      "gpu_peak_max": -0.2,
      "latency_max": 10.0
    },
    "targets": {
      "accuracy_min": -0.3,
      "gpu_peak_max": -0.4,
      "latency_max": 1.0
    }
  },
  "optimizer": {
    "type": "optuna_multiobjective",
    "optuna": {
      "n_trials": 20,
      "n_startup_trials": 8,
      "sampler": "TPESampler",
      "tpe_params": {
        "n_ei_candidates": 24,
        "multivariate": true,
        "constant_liar": false
      },
      "nsgaii_params": {
        "population_size": 20,
        "mutation_prob": 0.1,
        "crossover_prob": 0.9
      }
    },
    "qehvi": {
      "n_trials": 30,
      "n_initial_random": 10,
      "batch_size": 1,
      "gp_kernel": "Matern",
      "gp_nu": 2.5,
      "mc_samples": 256
    },
    "search_space": {
      "methods": [
        "gptq",
        "awq",
        "bnb"
      ],
      "gptq": {
        "bits": [
          2,
          3,
          4,
          8
        ],
        "group_size": [
          -1,
          16,
          32,
          64,
          128
        ],
        "calib_num": [
          256
        ],
        "desc_act": [
          true,
          false
        ],
        "sym": [
          true,
          false
        ],
        "damp_percent": [
          0.001,
          0.005,
          0.01,
          0.03,
          0.05
        ],
        "damp_auto_increment": [
          0.001,
          0.005,
          0.01,
          0.03,
          0.05
        ],
        "act_group_aware": [
          false
        ],
        "static_groups": [
          true,
          false
        ],
        "true_sequential": [
          true,
          false
        ],
        "lm_head": [
          false
        ],
        "mse": [
          0.0,
          0.1,
          0.2
        ],
        "rotation": [
          null
        ]
      },
      "awq": {
        "w_bit": [
          4
        ],
        "q_group_size": [
          16,
          32,
          64,
          128
        ],
        "zero_point": [
          true,
          false
        ],
        "version": [
          "gemm"
        ],
        "modules_to_not_convert": [
          [
            "lm_head"
          ],
          [
            "embed_tokens"
          ],
          [
            "lm_head",
            "embed_tokens"
          ],
          [
            "lm_head",
            "layers.*norm*"
          ],
          []
        ]
      },
      "bnb": {
        "bits": [
          4,
          8
        ],
        "bnb_4bit_quant_type": [
          "nf4",
          "fp4"
        ],
        "bnb_4bit_use_double_quant": [
          true,
          false
        ],
        "bnb_4bit_compute_dtype": [
          "float16",
          "bfloat16"
        ],
        "llm_int8_threshold": [
          4.0,
          4.5,
          5.0,
          6.0
        ],
        "llm_int8_skip_modules": [
          [
            "lm_head"
          ]
        ],
        "llm_int8_has_fp16_weight": [
          false
        ],
        "llm_int8_enable_fp32_cpu_offload": [
          false
        ]
      }
    }
  },
  "output": {
    "save_all_trials": true,
    "save_pareto_frontier": true,
    "recommendation": {
      "strategy": "closest_to_target"
    },
    "visualization": {
      "enabled": false,
      "plot_types": [
        "3d_pareto",
        "parallel_coordinates",
        "trade_off_matrix"
      ],
      "output_format": "html"
    }
  },
  "logging": {
    "level": "INFO",
    "save_logs": true,
    "log_file": "optimization.log"
  },
  "cache": {
    "enable_baseline_cache": true,
    "cache_dir": ".cache/optimization"
  }
}