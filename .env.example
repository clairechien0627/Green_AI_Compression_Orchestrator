# 複製這個檔案為 .env（跟這個範例檔同一層，也就是 repo 根目錄），並填入實際的值。
# .env 已經在 .gitignore 裡，不會被 commit。

# ── LLM Agent 決策（src/Global_Tuner/）必填 ──────────────────────
# OpenAI API key，用於 LLM 決策與（summary 記憶策略的）摘要呼叫
LLM_API_KEY=sk-...

# 選填，未設定時預設 gpt-4o
LLM_MODEL=gpt-4o

# 選填，summary 記憶策略用來壓縮歷史的次要模型，未設定時預設 gpt-4o-mini
SUMMARY_MODEL=gpt-4o-mini

# ── 下載 Llama 系列模型（gated model）必填 ────────────────────────
# 到 https://huggingface.co/settings/tokens 建立 token，並先在對應模型頁面
# （例如 meta-llama/Llama-3.2-3B-Instruct）申請存取權限
HF_TOKEN=hf_...
